GEMINI_API_KEY=
FIREBASE_API_KEY=
DISABLE_HMR=

# Server-side Google Drive upload credentials (allows guest photo uploads to YOUR Drive without user login)
# Option A (Simplest for personal @gmail.com Drive): Google Apps Script Web App URL
GOOGLE_APPS_SCRIPT_DRIVE_URL=https://script.google.com/macros/s/AKfycbzDGNTzF34Dy3fPEfhsJqaV0PpFbgMWIF4m2LVPV_JnT5F1e48VN581CPT6qXnwOC7oeA/exec
GOOGLE_APPS_SCRIPT_SECRET=

# Option B: OAuth Refresh Token (also works with personal @gmail.com Drive)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Option C: Google Cloud Service Account JSON (works with Google Workspace Shared Drives)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: Firebase Service Account JSON for server-side Firestore sync
FIREBASE_SERVICE_ACCOUNT_JSON=
